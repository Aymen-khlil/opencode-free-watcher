{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "opencode-free-watcher",
  "version": "0.1.3",
  "identifier": "com.ceazi.opencode-free-watcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenCode Free Models",
        "width": 420,
        "height": 560,
        "minWidth": 340,
        "minHeight": 420,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDQzQwQkE4NjM5RDgwQzAKUldUQWdKMWpxQXZFekxZYkFNbUFIenovQTFseFRtYTVmM1ErK0FtWWlYVG1Ya1MrbUlsQTNPcWYK",
      "endpoints": [
        "https://github.com/Aymen-khlil/opencode-free-watcher/releases/latest/download/latest.json"
      ]
    }
  }
}
